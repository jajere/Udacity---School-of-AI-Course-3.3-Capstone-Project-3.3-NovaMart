def build_refund_agent() -> Agent:
    """
    Build the Refund Agent.

    Makes return/refund eligibility decisions based on order facts from
    WorkflowState and applies the correct policy window per customer tier.
    """

    model = BedrockModel(
        model_id=config.WORKER_MODEL_ID,
        region_name=config.AWS_REGION,
        temperature=0.1,
        guardrail_id=config.GUARDRAIL_ID,
        guardrail_version=config.GUARDRAIL_VERSION,
    )

    system_prompt = """
You are the NovaMart Refund Agent.

Your job is to evaluate return/refund requests using factual information
already gathered by the Inventory Agent.

Rules:
- First use get_inventory_context to inspect the workflow state.
- Use the customer's tier and order information when determining eligibility.
- Standard customers normally have a 30-day return window.
- Premium customers normally have a 60-day return window.
- Do not invent order facts.
- Do not claim a refund was processed unless initiate_refund successfully
  confirms the operation.
- For an eligible return, use initiate_refund to record the return request.
- Clearly explain the decision and relevant facts.
"""

    @tool
    def get_inventory_context(session_id: str) -> dict:
        """
        Read the WorkflowState to access facts gathered by the InventoryAgent.
        """
        state = _read_workflow_state(session_id)

        if not state:
            return {
                "session_id": session_id,
                "inventory_agent": {},
                "message": "No workflow state found for this session.",
            }

        return {
            "session_id": session_id,
            "inventory_agent": state.get("inventory_agent", {}),
        }

    @tool
    def initiate_refund(
        customer_id: str,
        order_id: str,
        reason: str,
    ) -> dict:
        """
        Initiate a return by updating the order record in DynamoDB.
        """
        try:
            table = dynamodb.Table(config.ORDERS_TABLE)

            response = table.get_item(
                Key={
                    "customer_id": customer_id,
                    "order_id": order_id,
                }
            )

            order = response.get("Item")

            if not order:
                return {
                    "success": False,
                    "customer_id": customer_id,
                    "order_id": order_id,
                    "message": "Order not found.",
                }

            current_status = order.get("status", "")

            if current_status == "return_requested":
                return {
                    "success": False,
                    "customer_id": customer_id,
                    "order_id": order_id,
                    "message": "A return has already been requested for this order.",
                }

            return_reference = (
                f"RET-{uuid.uuid4().hex[:10].upper()}"
            )

            table.update_item(
                Key={
                    "customer_id": customer_id,
                    "order_id": order_id,
                },
                UpdateExpression=(
                    "SET #status = :status, "
                    "return_reference = :reference, "
                    "return_reason = :reason"
                ),
                ExpressionAttributeNames={
                    "#status": "status",
                },
                ExpressionAttributeValues={
                    ":status": "return_requested",
                    ":reference": return_reference,
                    ":reason": reason,
                },
            )

            return {
                "success": True,
                "customer_id": customer_id,
                "order_id": order_id,
                "return_reference": return_reference,
                "status": "return_requested",
                "reason": reason,
                "message": (
                    "Return request initiated successfully. "
                    "The customer should follow the return instructions "
                    "provided by NovaMart."
                ),
            }

        except Exception as exc:
            logger.exception("initiate_refund failed")
            return {
                "success": False,
                "customer_id": customer_id,
                "order_id": order_id,
                "error": str(exc),
            }

    return Agent(
        model=model,
        system_prompt=system_prompt,
        tools=[
            get_inventory_context,
            initiate_refund,
        ],
        name="RefundAgent",
        description="Evaluates and initiates customer return/refund requests.",
    )


