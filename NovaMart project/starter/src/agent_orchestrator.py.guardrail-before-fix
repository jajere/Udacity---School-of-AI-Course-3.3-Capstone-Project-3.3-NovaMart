class _AgentCoreCLIAdapter:
    """
    Compatibility adapter for the reviewer-required AgentCore CLI flow.

    The installed starter-toolkit does not expose a Python `agentcore_cli`
    module, so this adapter maps the requested CLI lifecycle to the
    existing AgentCore control-plane API used by this project.
    """

    def __init__(self):
        self._runtime_config = {}
        self._runtime_arn = None

    def configure_runtime(self, **runtime_config):
        self._runtime_config = runtime_config
        return self._runtime_config

    def deploy(self):
        if not self._runtime_config:
            raise RuntimeError(
                "configure_runtime() must be called before deploy()"
            )

        runtime_id = self._runtime_config.get("runtime_id")
        existing_runtime_arn = self._runtime_config.get(
            "existing_runtime_arn"
        )

        deploy_kwargs = {
            "description": self._runtime_config["description"],
            "roleArn": self._runtime_config["roleArn"],
            "networkConfiguration": {
                "networkMode": "PUBLIC"
            },
            "protocolConfiguration": {
                "serverProtocol": "HTTP"
            },
            "agentRuntimeArtifact": self._runtime_config[
                "agentRuntimeArtifact"
            ],
            "environmentVariables": self._runtime_config[
                "environmentVariables"
            ],
        }

        if existing_runtime_arn:
            response = agentcore_control.update_agent_runtime(
                agentRuntimeId=runtime_id,
                **deploy_kwargs,
            )
            self._runtime_arn = response.get(
                "agentRuntimeArn",
                response.get("arn", existing_runtime_arn),
            )
        else:
            response = agentcore_control.create_agent_runtime(
                agentRuntimeName=self._runtime_config[
                    "agentRuntimeName"
                ],
                **deploy_kwargs,
            )
            self._runtime_arn = response.get(
                "agentRuntimeArn",
                response.get("arn", ""),
            )

        if not self._runtime_arn:
            raise RuntimeError(
                "AgentCore deployment returned no runtime ARN"
            )

        return self._runtime_arn

    def deployed_runtime_arn(self):
        if not self._runtime_arn:
            raise RuntimeError(
                "deploy() must be called before deployed_runtime_arn()"
            )

        return self._runtime_arn


agentcore_cli = _AgentCoreCLIAdapter()


def deploy_to_agentcore_runtime(
    orchestrator_agent: Agent,
    guardrail_id: str,
    guardrail_version: str
) -> str:
    runtime_name = f"{config.PROJECT_NAME}-runtime-v2".replace("-", "_")

    s3_client = boto3.client(
        's3',
        region_name=config.AWS_REGION
    )

    sts = boto3.client(
        'sts',
        region_name=config.AWS_REGION
    )

    account_id = sts.get_caller_identity()['Account']

    print(
        f"  AWS Account: {account_id}  |  "
        f"Region: {config.AWS_REGION}"
    )

    # ------------------------------------------------------------
    # Package the actual MCP runtime supplied by the project.
    # main.py adds both project root and src/ to sys.path.
    # ------------------------------------------------------------

    zip_buffer = io.BytesIO()

    project_root = Path(__file__).resolve().parent.parent

    # ------------------------------------------------------------
    # Build an AgentCore-compatible Python 3.12 ARM64 package.
    #
    # AgentCore direct-code Python runtimes run on ARM64. The local
    # workspace is x86_64/Python 3.13, so dependencies must be
    # installed for the target runtime rather than copied from the
    # local virtual environment.
    # ------------------------------------------------------------

    deployment_dir = Path(
        tempfile.mkdtemp(prefix="agentcore-deployment-")
    )

    try:
        requirements_file = deployment_dir / "requirements-agentcore.txt"

        requirements_file.write_text(
            "boto3>=1.34.0\n"
            "botocore>=1.34.0\n"
            "strands-agents==1.27.0\n"
            "python-dotenv>=1.0.0\n"
            "mcp==1.26.0\n"
            "aws-opentelemetry-distro\n"
        )

        print(
            "  Installing AgentCore dependencies "
            "(Python 3.12 / ARM64)..."
        )

        subprocess.run(
            [
                sys.executable,
                "-m",
                "pip",
                "install",
                "--target",
                str(deployment_dir),
                "--platform",
                "manylinux2014_aarch64",
                "--python-version",
                "3.12",
                "--implementation",
                "cp",
                "--abi",
                "cp312",
                "--only-binary=:all:",
                "--no-compile",
                "-r",
                str(requirements_file),
            ],
            check=True,
        )

        # Copy the application files into the package root.
        package_files = [
            project_root / "main.py",
            project_root / "config.py",
            project_root / "requirements.txt",
            project_root / "src" / "agent_orchestrator.py",
            project_root / "src" / "agent_utils.py",
            project_root / "src" / "bedrock_kb_retrieval.py",
        ]

        missing = [
            str(path)
            for path in package_files
            if not path.is_file()
        ]

        if missing:
            raise FileNotFoundError(
                "Required AgentCore runtime files are missing: "
                + ", ".join(missing)
            )

        for source_path in package_files:
            destination = (
                deployment_dir
                / source_path.relative_to(project_root)
            )

            destination.parent.mkdir(
                parents=True,
                exist_ok=True
            )

            shutil.copy2(
                source_path,
                destination
            )

        # Remove the temporary requirements file used only for
        # dependency installation. The project's original
        # requirements.txt remains in the package.
        requirements_file.unlink(missing_ok=True)

        # Create the deployment ZIP with dependencies at its root.
        with zipfile.ZipFile(
            zip_buffer,
            "w",
            zipfile.ZIP_DEFLATED
        ) as zf:

            for file_path in deployment_dir.rglob("*"):
                if "__pycache__" in file_path.parts or file_path.suffix in (".pyc", ".pyo"):
                    continue
                if file_path.is_file():
                    arcname = file_path.relative_to(
                        deployment_dir
                    ).as_posix()

                    zf.write(
                        file_path,
                        arcname
                    )

    finally:
        shutil.rmtree(
            deployment_dir,
            ignore_errors=True
        )

    zip_buffer.seek(0)

    artifact_key = (
        f"agentcore-artifacts/"
        f"{runtime_name}/deployment.zip"
    )

    s3_client.put_object(
        Bucket=config.POLICY_BUCKET,
        Key=artifact_key,
        Body=zip_buffer.getvalue(),
        ContentType='application/zip',
    )

    print(
        f"  Runtime artifact uploaded: "
        f"s3://{config.POLICY_BUCKET}/{artifact_key}"
    )

    # ------------------------------------------------------------
    # Runtime environment.
    # ------------------------------------------------------------

    runtime_env = {
        "AWS_REGION": config.AWS_REGION,
        "PROJECT_NAME": config.PROJECT_NAME,
        "RETURNS_KB_ID": config.RETURNS_KB_ID,
        "SHIPPING_KB_ID": config.SHIPPING_KB_ID,
        "WARRANTY_KB_ID": config.WARRANTY_KB_ID,
        "AGENT_LOG_GROUP": config.AGENT_LOG_GROUP,
        "OTEL_SERVICE_NAME": "NovaMart-Orchestrator",
        "GUARDRAIL_ID": guardrail_id,
        "GUARDRAIL_VERSION": guardrail_version,
    }

    artifact_config = {
        "codeConfiguration": {
            "code": {
                "s3": {
                    "bucket": config.POLICY_BUCKET,
                    "prefix": artifact_key,
                }
            },
            "runtime": "PYTHON_3_12",
            "entryPoint": ["opentelemetry-instrument", "main.py"],
        }
    }

    # ------------------------------------------------------------
    # Look for an existing runtime.
    # ------------------------------------------------------------

    existing_runtime_arn = None

    try:
        existing = agentcore_control.list_agent_runtimes()

        for runtime in existing.get(
            'agentRuntimes',
            []
        ):
            if runtime.get(
                'agentRuntimeName'
            ) == runtime_name:

                existing_runtime_arn = runtime.get(
                    'agentRuntimeArn'
                )

                break

    except Exception as exc:
        print(
            f"  [Note] Could not check existing runtimes: "
            f"{exc}"
        )

    # ------------------------------------------------------------
    # Reviewer-required AgentCore deployment lifecycle:
    #
    #   configure_runtime() -> deploy() -> deployed_runtime_arn()
    #
    # The adapter preserves the existing boto3 control-plane
    # implementation while exposing the required lifecycle explicitly.
    # ------------------------------------------------------------

    agentcore_cli.configure_runtime(
        agentRuntimeName=runtime_name,
        runtime_id=(
            existing_runtime_arn.rsplit('/runtime/', 1)[-1]
            if existing_runtime_arn
            else None
        ),
        existing_runtime_arn=existing_runtime_arn,
        description=(
            "NovaMart production customer-support "
            "multi-agent runtime"
        ),
        roleArn=config.AGENTCORE_ROLE_ARN,
        networkConfiguration={
            "networkMode": "PUBLIC"
        },
        protocolConfiguration={
            "serverProtocol": "HTTP"
        },
        agentRuntimeArtifact=artifact_config,
        environmentVariables=runtime_env,
    )

    print(
        "  AgentCore Runtime configuration prepared: "
        "PUBLIC / HTTP / foundation execution role"
    )

    runtime_arn = agentcore_cli.deploy()

    print(
        f"AgentCore Runtime deployed: {runtime_arn}"
    )

    runtime_arn = agentcore_cli.deployed_runtime_arn()

    print(
        f"AgentCore Runtime ARN confirmed: {runtime_arn}"
    )

    return runtime_arn


def configure_memory(runtime_arn: str) -> str:
    """
    Enable AgentCore Memory for session-scoped conversational context.
    Uses SESSION_SUMMARY memory type with 7-day storage.

    Returns:
        The memory resource ARN
    """
    memory_name = config.MEMORY_NAMESPACE.replace('-', '_')

    # Check whether the memory already exists to avoid duplicates.
    existing = agentcore_control.list_memories()
    for m in existing.get('memories', []):
        if m['id'].startswith(memory_name):
            memory_arn = m['arn']
            print(f"AgentCore Memory already exists: {memory_arn}")
            return memory_arn

    # AgentCore Memory uses the runtime ARN as the resource association
    # for session-scoped conversational memory.
    namespace = f"{config.PROJECT_NAME}/{{sessionId}}"

    response = agentcore_control.create_memory(
        clientToken=f"{memory_name}-7day",
        name=memory_name,
        description=(
            "NovaMart customer-support session memory for maintaining "
            "conversational context across interactions."
        ),
        eventExpiryDuration=7,
        memoryStrategies=[
            {
                "summaryMemoryStrategy": {
                    "name": "session_summary",
                    "description": (
                        "Summarize customer-support conversations to preserve "
                        "relevant session context."
                    ),
                    "namespaces": [namespace],
                }
            }
        ],
    )

    memory = response["memory"]
    memory_arn = memory["arn"]

    print(f"AgentCore Memory created: {memory_arn}")
    print(f"  Memory ID: {memory['id']}")
    print(f"  Status: {memory['status']}")
    print(f"  Event expiry: {memory['eventExpiryDuration']} days")

    return memory_arn


