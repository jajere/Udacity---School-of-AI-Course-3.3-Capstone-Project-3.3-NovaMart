from opentelemetry import trace as otel_trace
from opentelemetry.trace import SpanKind

_kb_tracer = otel_trace.get_tracer("novamart.knowledgebase")


def _kb_span(kb_name: str):
    """Client span so each Knowledge Base appears as its own service-map node."""
    node = f"KnowledgeBase:{kb_name}"
    return _kb_tracer.start_as_current_span(
        node,
        kind=SpanKind.CLIENT,
        attributes={
            "aws.remote.service": node,
            "aws.remote.operation": "Retrieve",
            "peer.service": node,
        },
    )



def _agent_span(agent_name: str):
    """Client span so each worker agent appears as its own service-map node."""
    return _kb_tracer.start_as_current_span(
        agent_name,
        kind=SpanKind.CLIENT,
        attributes={
            "aws.remote.service": agent_name,
            "aws.remote.operation": "Invoke",
            "peer.service": agent_name,
        },
    )


def _traced_agent(agent, agent_name: str):
    def _call(*args, **kwargs):
        with _agent_span(agent_name):
            return agent(*args, **kwargs)
    return _call


def build_policy_agent() -> Agent:
    """
    Build the Policy Agent - a multi-agent RAG system.

    Internally creates three specialized retriever sub-agents that run in
    PARALLEL, each querying its own Knowledge Base. The coordinator synthesizes
    the combined results into a complete, grounded policy answer.
    """

    @tool
    def retrieve_returns_policy(query: str) -> str:
        """Retrieve relevant passages from the Returns Policy knowledge base."""
        with _kb_span("returns"):
            results = retrieve_from_knowledge_base(
                config.RETURNS_KB_ID,
                query,
                top_k=3,
            )
        return format_kb_results(results)

    returns_model = BedrockModel(
        model_id=config.WORKER_MODEL_ID,
        region_name=config.AWS_REGION,
        temperature=0.0,
        guardrail_id=config.GUARDRAIL_ID,
        guardrail_version=config.GUARDRAIL_VERSION,
    )

    returns_retriever = Agent(
        model=returns_model,
        system_prompt="""
You are the Returns Policy Retriever for NovaMart.

Use the retrieve_returns_policy tool to retrieve relevant passages from
the Returns Knowledge Base.

Return only information grounded in the retrieved policy documents.
Do not invent policy information.
""",
        tools=[retrieve_returns_policy],
        name="ReturnsPolicyRetrieverAgent",
        description="Retrieves NovaMart return policy information.",
    )

    @tool
    def retrieve_shipping_policy(query: str) -> str:
        """Retrieve relevant passages from the Shipping Policy knowledge base."""
        with _kb_span("shipping"):
            results = retrieve_from_knowledge_base(
                config.SHIPPING_KB_ID,
                query,
                top_k=3,
            )
        return format_kb_results(results)

    shipping_model = BedrockModel(
        model_id=config.WORKER_MODEL_ID,
        region_name=config.AWS_REGION,
        temperature=0.0,
        guardrail_id=config.GUARDRAIL_ID,
        guardrail_version=config.GUARDRAIL_VERSION,
    )

    shipping_retriever = Agent(
        model=shipping_model,
        system_prompt="""
You are the Shipping Policy Retriever for NovaMart.

Use the retrieve_shipping_policy tool to retrieve relevant passages from
the Shipping Knowledge Base.

Return only information grounded in the retrieved policy documents.
Do not invent policy information.
""",
        tools=[retrieve_shipping_policy],
        name="ShippingPolicyRetrieverAgent",
        description="Retrieves NovaMart shipping policy information.",
    )

    @tool
    def retrieve_warranty_policy(query: str) -> str:
        """Retrieve relevant passages from the Warranty Policy knowledge base."""
        with _kb_span("warranty"):
            results = retrieve_from_knowledge_base(
                config.WARRANTY_KB_ID,
                query,
                top_k=3,
            )
        return format_kb_results(results)

    warranty_model = BedrockModel(
        model_id=config.WORKER_MODEL_ID,
        region_name=config.AWS_REGION,
        temperature=0.0,
        guardrail_id=config.GUARDRAIL_ID,
        guardrail_version=config.GUARDRAIL_VERSION,
    )

    warranty_retriever = Agent(
        model=warranty_model,
        system_prompt="""
You are the Warranty Policy Retriever for NovaMart.

Use the retrieve_warranty_policy tool to retrieve relevant passages from
the Warranty Knowledge Base.

Return only information grounded in the retrieved policy documents.
Do not invent policy information.
""",
        tools=[retrieve_warranty_policy],
        name="WarrantyPolicyRetrieverAgent",
        description="Retrieves NovaMart warranty policy information.",
    )

    retrievers = {
        "Returns": returns_retriever,
        "Shipping": shipping_retriever,
        "Warranty": warranty_retriever,
    }

    @tool
    def search_all_policies(query: str) -> str:
        """
        Query all three policy knowledge bases IN PARALLEL.
        """

        trace.kb_start({
            "Returns": config.RETURNS_KB_ID,
            "Shipping": config.SHIPPING_KB_ID,
            "Warranty": config.WARRANTY_KB_ID,
        })

        def _run_retriever(domain: str, agent, query: str) -> tuple:
            try:
                result = agent(query)
                return domain, str(result)
            except Exception as exc:
                logger.exception(
                    "Policy retriever failed for %s",
                    domain,
                )
                return domain, f"Policy retrieval failed: {exc}"

        results = {}

        with ThreadPoolExecutor(max_workers=3) as executor:
            futures = {
                executor.submit(
                    _run_retriever,
                    domain,
                    agent,
                    query,
                ): domain
                for domain, agent in retrievers.items()
            }

            for future in as_completed(futures):
                domain, result_text = future.result()
                results[domain] = result_text

        trace.kb_done(len(retrievers))

        for domain in ["Returns", "Shipping", "Warranty"]:
            trace.kb_result(
                domain,
                results.get(domain, "[No results]"),
            )

        combined = []

        for domain in ["Returns", "Shipping", "Warranty"]:
            combined.append(
                f"===== {domain} Policy =====\n"
                f"{results.get(domain, '[No results]')}"
            )

        return "\n\n".join(combined)

    coordinator_model = BedrockModel(
        model_id=config.WORKER_MODEL_ID,
        region_name=config.AWS_REGION,
        temperature=0.2,
        guardrail_id=config.GUARDRAIL_ID,
        guardrail_version=config.GUARDRAIL_VERSION,
    )

    coordinator_prompt = """
You are the NovaMart Policy Agent.

You answer customer questions about:
- returns
- shipping
- warranties

Use search_all_policies to retrieve policy information from the three
specialized Knowledge Bases.

Your response must:
- Be grounded in retrieved policy information.
- Clearly distinguish information from the Returns, Shipping, and Warranty
  policies when relevant.
- Never invent policy rules.
- Never make unsupported assumptions.
- If the retrieved documents do not contain enough information, say so.
- Give the customer a concise, accurate policy explanation.

Do not make up exceptions or guarantees.
"""

    return Agent(
        model=coordinator_model,
        system_prompt=coordinator_prompt,
        tools=[search_all_policies],
        name="PolicyAgent",
        description="Coordinates parallel retrieval across NovaMart policy knowledge bases.",
    )


