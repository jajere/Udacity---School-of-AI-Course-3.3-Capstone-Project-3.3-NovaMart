def build_inventory_agent() -> Agent:
    """
    Build the Inventory Agent.

    Gathers order and customer facts from DynamoDB. Does NOT make decisions -
    only retrieves data for the OrchestratorAgent to share with downstream agents.
    """

    model = BedrockModel(
        model_id=config.WORKER_MODEL_ID,
        region_name=config.AWS_REGION,
        temperature=0.1,
        guardrail_id=config.GUARDRAIL_ID,
        guardrail_version=config.GUARDRAIL_VERSION,
    )

    system_prompt = """
You are the NovaMart Inventory Agent.

Your job is ONLY to gather factual customer and order information from DynamoDB.

You must:
- Retrieve order status and details.
- Retrieve customer account and tier information.
- List a customer's orders.
- Return factual information accurately.
- Never make refund, return, eligibility, policy, or compensation decisions.
- Never invent information.
- If information is unavailable, clearly say so.

You are a worker agent. The OrchestratorAgent and downstream agents use
your factual results to make decisions.
"""

    @tool
    def check_order_status(customer_id: str, order_id: str) -> dict:
        """
        Retrieve the complete status and details of an order.

        Args:
            customer_id: The customer's unique identifier.
            order_id: The order's unique identifier.

        Returns:
            Order details or an error/not-found response.
        """
        try:
            table = dynamodb.Table(config.ORDERS_TABLE)

            response = table.get_item(
                Key={
                    "customer_id": customer_id,
                    "order_id": order_id,
                }
            )

            item = response.get("Item")

            if not item:
                return {
                    "found": False,
                    "customer_id": customer_id,
                    "order_id": order_id,
                    "message": "Order not found.",
                }

            return {
                "found": True,
                "order": item,
            }

        except Exception as exc:
            logger.exception("check_order_status failed")
            return {
                "found": False,
                "customer_id": customer_id,
                "order_id": order_id,
                "error": str(exc),
            }

    @tool
    def get_customer_tier(customer_id: str) -> dict:
        """
        Retrieve a customer's tier and account details from DynamoDB.

        Args:
            customer_id: The customer's unique identifier.

        Returns:
            Customer profile including tier and account details.
        """
        try:
            table = dynamodb.Table(config.CUSTOMERS_TABLE)

            response = table.get_item(
                Key={
                    "customer_id": customer_id,
                }
            )

            item = response.get("Item")

            if not item:
                return {
                    "found": False,
                    "customer_id": customer_id,
                    "message": "Customer not found.",
                }

            return {
                "found": True,
                "customer": item,
            }

        except Exception as exc:
            logger.exception("get_customer_tier failed")
            return {
                "found": False,
                "customer_id": customer_id,
                "error": str(exc),
            }

    @tool
    def list_customer_orders(customer_id: str) -> dict:
        """
        Retrieve all orders for a customer from DynamoDB.

        Args:
            customer_id: The customer's unique identifier.

        Returns:
            List of all orders with order information.
        """
        try:
            table = dynamodb.Table(config.ORDERS_TABLE)

            response = table.query(
                KeyConditionExpression=Key("customer_id").eq(customer_id)
            )

            orders = response.get("Items", [])

            return {
                "customer_id": customer_id,
                "order_count": len(orders),
                "orders": orders,
            }

        except Exception as exc:
            logger.exception("list_customer_orders failed")
            return {
                "customer_id": customer_id,
                "order_count": 0,
                "orders": [],
                "error": str(exc),
            }

    return Agent(
        model=model,
        system_prompt=system_prompt,
        tools=[
            check_order_status,
            get_customer_tier,
            list_customer_orders,
        ],
        name="InventoryAgent",
        description="Retrieves customer and order facts from DynamoDB.",
    )


