def apply_observability_config(loggingConfiguration: dict) -> None:
    """
    Apply the completed AgentCore observability configuration.

    This helper isolates the control-plane API call from the
    configuration-building logic in configure_observability().
    """
    runtime_arn = config.AGENTCORE_RUNTIME_ARN
    runtime_id = runtime_arn.split('/')[-1]

    if hasattr(agentcore_control, 'put_agent_runtime_logging_configuration'):
        agentcore_control.put_agent_runtime_logging_configuration(
            agentRuntimeId=runtime_id,
            loggingConfiguration=loggingConfiguration,
        )
    else:
        raise AttributeError(
            "put_agent_runtime_logging_configuration is not available"
        )


def configure_observability(runtime_arn: str) -> None:
    """
    Configure AgentCore Observability:
    - Agent logs → CloudWatch Logs at INFO level
    - Execution traces → AWS X-Ray at 100% sampling

    The completed loggingConfiguration is passed to the
    pre-defined observability helper.
    """
    runtime_id = runtime_arn.split('/')[-1]

    loggingConfiguration = {
        'cloudWatchConfig': {
            'logGroupName': config.AGENT_LOG_GROUP,
            'logLevel': 'INFO',
            'enabled': True,
        },
        'xRayConfig': {
            'enabled': True,
            'samplingRate': 1.0,
        },
    }

    try:
        apply_observability_config(loggingConfiguration)

        print(f"Observability configured for runtime: {runtime_id}")
        print(f"  CloudWatch log group: {config.AGENT_LOG_GROUP}")
        print("  X-Ray sampling rate: 1.0")

    except Exception as e:
        print(f"[Note] Logging config skipped (SDK version mismatch): {e}")


