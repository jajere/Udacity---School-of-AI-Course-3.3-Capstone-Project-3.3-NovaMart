def build_orchestrator_agent(
    inventory_agent: Agent,
    refund_agent: Agent,
    policy_agent: Agent,
    communication_agent: Agent,
) -> Agent:
    """
    Build the Orchestrator Agent that routes requests and manages WorkflowState.
    """
    inventory_agent = _traced_agent(inventory_agent, "InventoryAgent")
    refund_agent = _traced_agent(refund_agent, "RefundAgent")
    policy_agent = _traced_agent(policy_agent, "PolicyAgent")
    communication_agent = _traced_agent(communication_agent, "CommunicationAgent")


    model = BedrockModel(
        model_id=config.ORCHESTRATOR_MODEL_ID,
        region_name=config.AWS_REGION,
        temperature=0.0,
        guardrail_id=config.GUARDRAIL_ID,
        guardrail_version=config.GUARDRAIL_VERSION,
    )

    system_prompt = """
You are the NovaMart Orchestrator Agent.

You coordinate the specialized worker agents and manage the workflow.

CRITICAL RULES:

1. For EVERY customer request, call initialize_session FIRST.

2. Order status, order history, and return/refund requests:
   - Call route_to_inventory_agent first.
   - For a return/refund request, call route_to_refund_agent after inventory.
   - Then call route_to_communication_agent LAST.

3. Policy questions about returns, shipping, or warranties:
   - Call route_to_policy_agent.
   - Then call route_to_communication_agent LAST.

4. Account questions:
   - Route to route_to_inventory_agent.
   - Never route account questions to the Policy Agent.
   - Then call route_to_communication_agent LAST.

5. Mathematical/calculation questions:
   - You may answer the calculation directly.
   - You still must call initialize_session first.
   - Call route_to_communication_agent LAST.

6. The Orchestrator must NEVER compose the final customer response itself.
   CommunicationAgent always produces the final customer-facing response.

7. Do not invent facts.

8. Pass the customer's original request accurately to worker agents.

9. Follow the correct workflow ordering and do not skip required workers.
"""

    @tool
    def route_to_inventory_agent(
        session_id: str,
        customer_id: str,
        request: str,
    ) -> str:
        """
        Route an order-related request to the Inventory Agent.
        """
        try:
            # Read WorkflowState BEFORE calling the worker
            current = _read_workflow_state(session_id)
            if not current:
                return "Workflow state not found."

            # Capture the version that existed before the worker call
            expected_version = int(current["version"])

            result = inventory_agent(
                f"""
Session ID: {session_id}
Customer ID: {customer_id}

Customer request:
{request}

Gather all relevant customer and order facts needed for this request.
Do not make a return/refund decision.
"""
            )

            result_text = str(result)

            _update_workflow_state(
                session_id,
                {
                    "inventory_agent": {
                        "customer_id": customer_id,
                        "request": request,
                        "result": result_text,
                    }
                },
                expected_version,
            )

            return result_text

        except Exception as exc:
            logger.exception("route_to_inventory_agent failed")
            return f"Inventory Agent error: {exc}"

    @tool
    def route_to_policy_agent(
        session_id: str,
        request: str,
    ) -> str:
        """
        Route a policy question to the Policy Agent.
        """
        try:
            # Read WorkflowState BEFORE calling the worker (may not exist yet
            # if initialize_session is still running in the same turn).
            current = _read_workflow_state(session_id)
            expected_version = int(current["version"]) if current else None

            # Always run the Policy Agent: retrieval does not depend on state.
            result = policy_agent(
                f"""
Session ID: {session_id}

Customer policy question:
{request}

Retrieve the relevant policies and provide a grounded policy answer.
"""
            )

            result_text = str(result)

            # Best-effort state update.
            if current is None:
                current = _read_workflow_state(session_id)
                expected_version = int(current["version"]) if current else None

            if current is not None:
                try:
                    _update_workflow_state(
                        session_id,
                        {
                            "policy_agent": {
                                "request": request,
                                "result": result_text,
                            }
                        },
                        expected_version,
                    )
                except Exception:
                    logger.exception("Could not record policy result in WorkflowState")

            return result_text

        except Exception as exc:
            logger.exception("route_to_policy_agent failed")
            return f"Policy Agent error: {exc}"

    @tool
    def route_to_refund_agent(
        session_id: str,
        customer_id: str,
        request: str,
    ) -> str:
        """
        Route a return/refund request to the Refund Agent.
        Must be called after InventoryAgent.
        """
        try:
            # Read WorkflowState BEFORE calling the worker
            current = _read_workflow_state(session_id)
            if not current:
                return "Workflow state not found."

            # Capture the version that existed before the worker call
            expected_version = int(current["version"])

            result = refund_agent(
                f"""
Session ID: {session_id}
Customer ID: {customer_id}

Customer return/refund request:
{request}

First inspect the workflow state using get_inventory_context.
Use the gathered inventory facts to evaluate the request.
If appropriate and eligible, initiate the return.
"""
            )

            result_text = str(result)

            _update_workflow_state(
                session_id,
                {
                    "refund_agent": {
                        "customer_id": customer_id,
                        "request": request,
                        "result": result_text,
                    }
                },
                expected_version,
            )

            return result_text

        except Exception as exc:
            logger.exception("route_to_refund_agent failed")
            return f"Refund Agent error: {exc}"

    @tool
    def route_to_communication_agent(
        session_id: str,
        customer_id: str,
        original_request: str,
    ) -> str:
        """
        Route to CommunicationAgent to compose the final customer response.
        """
        try:
            # Read WorkflowState BEFORE calling the final worker
            current = _read_workflow_state(session_id)
            if not current:
                return "Workflow state not found."

            # Capture the version that existed before the worker call
            expected_version = int(current["version"])

            result = communication_agent(
                f"""
Session ID: {session_id}
Customer ID: {customer_id}

Original customer request:
{original_request}

Read the complete workflow state and compose the final customer-facing
response. Do not expose internal workflow information.
"""
            )

            result_text = str(result)

            # Persist the final communication result
            _update_workflow_state(
                session_id,
                {
                    "communication_agent": {
                        "result": result_text,
                    }
                },
                expected_version,
            )

            return result_text

        except Exception as exc:
            logger.exception("route_to_communication_agent failed")
            return f"Communication Agent error: {exc}"

    @tool
    def initialize_session(
        session_id: str,
        customer_id: str,
    ) -> str:
        """
        Create a blank WorkflowState record at the start of each request.
        """
        try:
            created = _create_workflow_state(
                session_id=session_id,
                customer_id=customer_id,
            )

            if created:
                return (
                    f"Session {session_id} initialized successfully "
                    f"for customer {customer_id}."
                )

            existing = _read_workflow_state(session_id)

            if existing:
                return (
                    f"Session {session_id} already exists. "
                    "Existing workflow state will be reused."
                )

            return (
                f"Session {session_id} could not be initialized."
            )

        except Exception as exc:
            logger.exception("initialize_session failed")
            return f"Session initialization error: {exc}"

    return Agent(
        model=model,
        system_prompt=system_prompt,
        tools=[
            initialize_session,
            route_to_inventory_agent,
            route_to_policy_agent,
            route_to_refund_agent,
            route_to_communication_agent,
        ],
        name="OrchestratorAgent",
        description="Routes NovaMart customer requests through specialized agents.",
    )


